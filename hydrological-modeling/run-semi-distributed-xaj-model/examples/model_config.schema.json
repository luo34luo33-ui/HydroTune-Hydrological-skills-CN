{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydrotune.local/semi-distributed-xaj-config/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "time", "xaj", "routing", "initial", "warmup_steps", "simulation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "time": {"type": "object", "additionalProperties": false,
      "required": ["step_seconds", "timezone", "timestamp_meaning"],
      "properties": {"step_seconds": {"type": "number", "exclusiveMinimum": 0},
        "timezone": {"type": "string", "minLength": 1}, "timestamp_meaning": {"const": "interval_end"}}},
    "xaj": {"type": "object", "additionalProperties": false,
      "required": ["KC", "B", "C", "IMP", "WM", "WUM", "WLM", "SM", "EX", "KG", "KI", "CG", "CI", "CS", "KE", "XE"],
      "properties": {"KC": {"type": "number", "exclusiveMinimum": 0}, "B": {"type": "number", "minimum": 0},
        "C": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "IMP": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "WM": {"type": "number", "exclusiveMinimum": 0}, "WUM": {"type": "number", "exclusiveMinimum": 0},
        "WLM": {"type": "number", "exclusiveMinimum": 0}, "SM": {"type": "number", "exclusiveMinimum": 0},
        "EX": {"type": "number", "minimum": 0}, "KG": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "KI": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "CG": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "CI": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "CS": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "KE": {"type": "number", "exclusiveMinimum": 0}, "XE": {"type": "number", "minimum": 0, "maximum": 0.5}}},
    "routing": {"type": "object", "additionalProperties": false, "required": ["dp_by_reach", "lag_steps"],
      "properties": {"dp_by_reach": {"type": "object", "minProperties": 1,
        "patternProperties": {"^[1-9][0-9]*$": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
        "lag_steps": {"type": "integer", "minimum": 0}}},
    "initial": {"type": "object", "additionalProperties": false,
      "required": ["soil_fraction", "s_mm", "fr", "qi_m3s", "qg_m3s", "qs_cs_m3s", "qi_cs_m3s", "qg_cs_m3s"],
      "properties": {"soil_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "s_mm": {"type": "number", "minimum": 0}, "fr": {"type": "number", "minimum": 0, "maximum": 1},
        "qi_m3s": {"type": "number", "minimum": 0}, "qg_m3s": {"type": "number", "minimum": 0},
        "qs_cs_m3s": {"type": "number", "minimum": 0}, "qi_cs_m3s": {"type": "number", "minimum": 0},
        "qg_cs_m3s": {"type": "number", "minimum": 0}}},
    "warmup_steps": {"type": "integer", "minimum": 0},
    "simulation": {"type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"type": "string", "minLength": 1}, "end": {"type": "string", "minLength": 1}}}
  }
}
