{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydrotune.local/schemas/calibration-problem.schema.json",
  "title": "HydroTune calibration problem",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapter", "inputs", "parameters", "objective", "splits", "data_shape", "warmup", "variables", "objective_consistency_tolerance"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "adapter": {"$ref": "#/$defs/fileReference"},
    "inputs": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/fileReference"}, {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}] }},
    "parameters": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "lower", "upper"], "properties": {"name": {"type": "string", "minLength": 1}, "lower": {"type": "number"}, "upper": {"type": "number"}}}},
    "objective": {"type": "object", "additionalProperties": false, "required": ["metric", "direction"], "properties": {"metric": {"type": "string", "minLength": 1}, "direction": {"enum": ["minimize", "maximize"]}}},
    "splits": {"type": "object", "additionalProperties": false, "required": ["calibration", "validation"], "properties": {"calibration": {"type": "string", "minLength": 1}, "validation": {"type": "string", "minLength": 1}}},
    "data_shape": {"enum": ["continuous", "event_collection"]},
    "warmup": {"type": "object", "additionalProperties": false, "required": ["confirmed", "semantics"], "properties": {"confirmed": {"const": true}, "semantics": {"type": "string", "minLength": 1}}},
    "variables": {"type": "object", "minProperties": 2, "additionalProperties": {"type": "object", "required": ["semantics", "units"], "properties": {"semantics": {"type": "string", "minLength": 1}, "units": {"type": "string", "minLength": 1}}}},
    "objective_consistency_tolerance": {"type": "number", "minimum": 0}
  },
  "$defs": {
    "fileReference": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}}
  }
}
