{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydrotune.dev/schemas/workflow.schema.json",
  "title": "HydroTune workflow contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow", "stages", "feedback_targets"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "workflow": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    },
    "feedback_targets": {
      "type": "array",
      "items": { "$ref": "#/$defs/feedback" }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "description", "depends_on", "inputs", "outputs", "qc"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "type": { "enum": ["abstract", "skill"] },
        "description": { "type": "string", "minLength": 1 },
        "depends_on": { "$ref": "#/$defs/stringList" },
        "inputs": { "$ref": "#/$defs/stringList" },
        "outputs": { "$ref": "#/$defs/stringList" },
        "skill_ref": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "qc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "checks"],
          "properties": {
            "required": { "type": "boolean" },
            "checks": { "$ref": "#/$defs/stringList" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "skill" } } },
          "then": { "required": ["skill_ref"] },
          "else": { "not": { "required": ["skill_ref"] } }
        }
      ]
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_stage", "workflow", "description", "automatic"],
      "properties": {
        "from_stage": { "type": "string", "minLength": 1 },
        "workflow": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "description": { "type": "string", "minLength": 1 },
        "automatic": { "const": false }
      }
    }
  }
}

