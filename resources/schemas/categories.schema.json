{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydrotune.dev/schemas/categories.schema.json",
  "title": "HydroTune category registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "categories"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title_zh", "description", "includes", "excludes", "overlaps"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title_zh": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "includes": { "$ref": "#/$defs/nonEmptyStrings" },
          "excludes": { "$ref": "#/$defs/nonEmptyStrings" },
          "overlaps": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}

